<?xml version="1.0"?>
<robot name="drive_robot" xmlns:xacro="http://wiki.ros.org/xacro" >

    <xacro:include filename="drive_robot_gazebo.xacro" />
    
    <link name="base_footprint"/>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.3 0.2 0.1" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="blue">
                <color rgba="0 0 0.5 1" />
            </material>
        </visual>
        <collision name="collision">
            <geometry>
                <box size="0.3 0.2 0.1" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision> 
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="2" />
            <inertia
                ixx="8.33e-03" ixy="0" ixz="0"
                iyy="1.667e-02" iyz="0" 
                izz="2.1667e-02" />
        </inertial>
    </link>

    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1" />
            </material>
        </visual>
        <collision name="collision">
            <geometry>
                <cylinder radius="0.05" length="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.3" />
            <inertia
                ixx="2.5e-04" ixy="0" ixz="0"
                iyy="2.5e-04" iyz="0"
                izz="6.25e-05" />
        </inertial>
    </link>

    <link name="right_wheel">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.3" />
            <inertia
                ixx="2.5e-04" ixy="0" ixz="0"
                iyy="2.5e-04" iyz="0" 
                izz="6.25e-05" />
        </inertial>
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1" />
            </material>
        </visual>
        <collision name="collision">
            <geometry>
                <cylinder radius="0.05" length="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
    </link>

    <link name="caster_wheel">
        <visual>
            <geometry>
                <sphere radius="0.025" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="black">
                <color rgba="0.0 0.0 0.0 1" />
            </material>
        </visual>
        <collision>
            <geometry>
                <sphere radius="0.025" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.2" />
            <inertia
                ixx="8.333e-05" ixy="0" ixz="0"
                iyy="8.333e-05" iyz="0" 
                izz="8.333e-05" />
        </inertial>
    </link>

    <joint name="base_footprint_base_link_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 0.1" rpy="0 0 0" />
    </joint>

    <joint name="base_link_left_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="left_wheel" />
        <origin xyz="-0.075 0.125 -0.05" rpy="-1.5707 0 0" />
        <axis xyz="0 0 1" />
        <limit effort="500.0" velocity="20.0" />
        <dynamics damping="1.0" friction="0.1" />
    </joint>

    <joint name="base_link_right_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="right_wheel" />
        <origin xyz="-0.075 -0.125 -0.05" rpy="-1.5707 0 0" />
        <axis xyz="0 0 1" />
        <limit effort="500.0" velocity="20.0" />
        <dynamics damping="1.0" friction="0.1" />
    </joint>

    <joint name="base_link_caster_wheel_joint" type="continuous">
        <parent link="base_link" />
        <child link="caster_wheel" />
        <origin xyz="0.075 0 -0.075" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit effort="500.0" velocity="20.0" />
        <dynamics damping="1.0" friction="0.0001" />
    </joint>

</robot>