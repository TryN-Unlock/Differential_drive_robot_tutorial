<launch>
    <let name="urdf_path" 
            value="$(find-pkg-share gazebo_teleop_world)/model/drive_robot.urdf.xacro" />

    <let name="world_path"
            value="$(find-pkg-share gazebo_teleop_world)/worlds/robot_project.sdf" />

    <let name="parameter_bridge" 
            value="$(find-pkg-share gazebo_teleop_world)/params/bridge.yaml" />  

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(command 'xacro $(var urdf_path)')" />
        <param name="use_sim_time" value="true" />
    </node>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="$(var world_path) -r" />
        <arg name="on_exit_shutdown" value="true" />
    </include>

    <node pkg="ros_gz_sim" exec="create" args=" -topic robot_description" />

    <node pkg="ros_gz_bridge" exec="parameter_bridge">
        <param name="config_file" value="$(var parameter_bridge)" />
        <param name="use_sim_time" value="true" />
    </node>

    <node pkg="rviz2" exec="rviz2" output="screen" 
            args="-d $(find-pkg-share gazebo_teleop_world)/rviz/drive_robot_config.rviz">
        <param name="use_sim_time" value="true" />
    </node>

</launch>