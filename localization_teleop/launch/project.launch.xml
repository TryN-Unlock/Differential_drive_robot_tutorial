<launch>
    <let name="urdf_path" 
            value="$(find-pkg-share localization_teleop)/model/drive_robot.urdf.xacro" />

    <let name="world_path"
            value="$(find-pkg-share localization_teleop)/worlds/robot_project.sdf" />

    <let name="parameter_bridge" 
            value="$(find-pkg-share localization_teleop)/params/bridge.yaml" />  

    <let name="ekf_path" value="$(find-pkg-share localization_teleop)/params/ekf.yaml" />

    <let name="localization_config_path"
            value="$(find-pkg-share localization_teleop)/params/nav2_amcl.yaml" /> 

    <let name="map_path" 
            value="$(find-pkg-share localization_teleop)/maps/map_1749722252.yaml" />

    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(command 'xacro $(var urdf_path)')" />
        <param name="use_sim_time" value="true" />
    </node>

    <include file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="$(var world_path) -r" />
        <arg name="on_exit_shutdown" value="true" />
    </include>

    <node pkg="ros_gz_sim" exec="create" args=" -topic robot_description" />

    <node pkg="ros_gz_bridge" exec="parameter_bridge">
        <param name="config_file" value="$(var parameter_bridge)" />
        <param name="use_sim_time" value="true" />
    </node>

    <node pkg="robot_localization" exec="ekf_node" name="ekf_node" output="screen" >
        <param from="$(var ekf_path)" />
        <param name="use_sim_time" value="true" />
    </node>

    <include file="$(find-pkg-share localization_teleop)/launch/drive_robot_navigation.launch.py">
        <arg name="use_sim_time" value="true" />
        <arg name="params_file" value="$(var localization_config_path)" />
        <arg name="map" value="$(var map_path)" />
    </include>

    <node pkg="rviz2" exec="rviz2" output="screen" 
            args="-d $(find-pkg-share localization_teleop)/rviz/amcl_localization_config.rviz">
        <param name="use_sim_time" value="true" />
    </node>

</launch>