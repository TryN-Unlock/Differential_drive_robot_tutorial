                        <ambient>0.523 0.367 0.234 1</ambient>
                        <diffuse>0.523 0.367 0.234 1</diffuse>
                        <specular>0.238 0.219 0.273 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <model name="box1">
            <static>true</static>
            <pose relative_to="world">0 2.5 0.5 0 0 0</pose>
            <link name="box1">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.5 0.5 1</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.5 0.5 1</size>
