<?xml version="1.0"?>
<sdf version="1.10">
    <world name="robot_project">
        <physics name="1ms" type="ignored">
            <max_step_size>0.02</max_step_size>
            <real_time_factor>1.0</real_time_factor>
        </physics>
        <plugin filename="gz-sim-physics-system" 
                name="gz::sim::systems::Physics">
        </plugin>
        <plugin filename="gz-sim-user-commands-system" 
                name="gz::sim::systems::UserCommands">
        </plugin>
        <plugin filename="gz-sim-scene-broadcaster-system" 
                name="gz::sim::systems::SceneBroadcaster">
        </plugin>
        <plugin filename="gz-sim-imu-system"
                name="gz::sim::systems::Imu">
        </plugin>
        <plugin filename="gz-sim-sensors-system"
                name="gz::sim::systems::Sensors">
        <render_engine>ogre2</render_engine>
        </plugin>
        
        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                        </plane>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>300 300</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                        <specular>0.8 0.8 0.8 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Contents of the main room-->
        <model name="mainroom_front_wall">
            <static>true</static>
            <pose relative_to="ground_plane">2.2 1.25 1.0 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.2 5.0 2.0</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.2 5.0 2.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.523 0.367 0.234 1</ambient>
                        <diffuse>0.523 0.367 0.234 1</diffuse>
                        <specular>0.238 0.219 0.273 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <model name="mainroom_left_wall">
            <static>true</static>
            <pose relative_to="world">-1.5 3.75 1.0 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>5.0 0.2 2.0</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>5.0 0.2 2.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.523 0.367 0.234 1</ambient>
                        <diffuse>0.523 0.367 0.234 1</diffuse>
                        <specular>0.238 0.219 0.273 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <model name="mainroom_right_wall">
            <static>true</static>
            <pose relative_to="world">-0.3 -1.25 1.0 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>5.0 0.2 2.0</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>5.0 0.2 2.0</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.523 0.367 0.234 1</ambient>
                        <diffuse>0.523 0.367 0.234 1</diffuse>
                        <specular>0.238 0.219 0.273 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <model name="mainroom_behind_wall">
            <static>true</static>
            <pose relative_to="ground_plane">-4 -2.25 1.0 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.2 12.0 2.0</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.2 12.0 2.0</size>
