                        <specular>0.5 0.5 0.5 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <!-- Adding Tables to world-->
        <include>
            <name>mainroom_BedTable1</name>
            <uri>
            https://fuel.gazebosim.org/1.0/OpenRobotics/models/BedTable
            </uri>
            <pose relative_to="ground_plane">-3.3 0.2 0 0 0 -3.1415</pose>
        </include>
        <include>
            <name>mainroom_BedTable2</name>
            <uri>
            https://fuel.gazebosim.org/1.0/OpenRobotics/models/BedTable
            </uri>
            <pose relative_to="ground_plane">-3.3 1 0 0 0 3.1415</pose>
        </include>
        <include>
            <name>mainroom_BedTable3</name>
            <uri>
            https://fuel.gazebosim.org/1.0/OpenRobotics/models/BedTable
            </uri>
            <pose relative_to="ground_plane">-3.3 1.8 0 0 0 3.1415</pose>
        </include>

        <!-- Contents of the left side room-->
        <model name="left_sideroom_bottom_wall">
            <static>true</static>
            <pose relative_to="ground_plane">0.5 5.35 1.0 0 0 0</pose>
