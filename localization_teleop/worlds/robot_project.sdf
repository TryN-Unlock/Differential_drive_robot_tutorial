        </model>

        <model name="box2">
            <static>true</static>
            <pose relative_to="world">-2 2.8 0.5 0 0 0</pose>
            <link name="box2">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.5 0.5 1</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.5 0.5 1</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.5 0.5 0.5 1</ambient>
                        <diffuse>0.5 0.5 0.5 1</diffuse>
                        <specular>0.5 0.5 0.5 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <model name="box3">
            <static>true</static>
            <pose relative_to="world">-1.4 -0.8 0.5 0 0 0</pose>
            <link name="box3">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.5 0.5 1</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.5 0.5 1</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.5 0.5 0.5 1</ambient>
                        <diffuse>0.5 0.5 0.5 1</diffuse>
                        <specular>0.5 0.5 0.5 1</specular>
                    </material>
                </visual>
            </link>
        </model>

        <model name="box4">
            <static>true</static>
            <pose relative_to="world">0 3 0.5 0 0 0</pose>
            <link name="box4">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.5 0.5 1</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.5 0.5 1</size>
