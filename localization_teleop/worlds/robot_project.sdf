        <!-- Adding bookshelf to left room-->
        <include>
            <name>leftroom_bookshelf1</name>
            <uri>
            https://fuel.gazebosim.org/1.0/OpenRobotics/models/Bookshelf
            </uri>
            <pose relative_to="ground_plane">1.3 6.5 0 0 0 0</pose>
        </include>
        <include>
            <name>leftroom_bookshelf2</name>
            <uri>
            https://fuel.gazebosim.org/1.0/OpenRobotics/models/Bookshelf
            </uri>
            <pose relative_to="ground_plane">2.3 6.5 0 0 0 0</pose>
        </include>

        <!-- Adding coffee table and chair in left room-->
        <include>
            <name>leftroom_coffeetable</name>
            <uri>
            https://fuel.gazebosim.org/1.0/OpenRobotics/models/CoffeeTable
            </uri>
            <pose relative_to="ground_plane">4.0 2.5 0 0 0 0</pose>
        </include>
        <include>
            <name>leftroom_chair</name>
            <uri>
            https://fuel.gazebosim.org/1.0/will0993/models/WoodenChair
            </uri>
            <pose relative_to="ground_plane">4.0 3.2 0 0 0 -1.57</pose>
        </include>

        <!-- Contents of lower right hallway-->
        <model name="horizontalhallway_top_wall">
            <static>true</static>
            <pose relative_to="ground_plane">-2.7 -3.15 1.0 0 0 0</pose>
